{
  "name": "react-access-control",
  "version": "0.0.1",
  "description": "Type-safe access control engine with React 18 adapter",
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts src/react/createAccessContext.tsx --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts src/react/createAccessContext.tsx --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["react", "access-control", "permissions", "rbac", "typescript"],
  "author": "",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "type": "module",
  "sideEffects" : false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react/createAccessContext.d.ts",
      "import": "./dist/react/createAccessContext.js",
      "require": "./dist/react/createAccessContext.cjs"
    }
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@types/react": "^18.3.0",
    "react": "^18.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
